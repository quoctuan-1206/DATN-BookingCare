generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model appointments {
  id                 Int                  @id @default(autoincrement())
  schedule_id        Int
  patient_profile_id Int
  reason             String?              @db.Text
  status             appointments_status? @default(PENDING)
  booking_code       String?              @unique(map: "booking_code") @db.VarChar(50)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  updated_at         DateTime?            @default(now()) @db.Timestamp(0)
  schedules          schedules            @relation(fields: [schedule_id], references: [id], onUpdate: NoAction, map: "appointments_ibfk_1")
  patient_profiles   patient_profiles     @relation(fields: [patient_profile_id], references: [id], onUpdate: NoAction, map: "appointments_ibfk_2")
  invoices           invoices[]
  medical_records    medical_records?
  reviews            reviews?

  @@index([patient_profile_id], map: "patient_profile_id")
  @@index([schedule_id], map: "schedule_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model articles {
  id               Int                   @id @default(autoincrement())
  title            String                @db.VarChar(255)
  slug             String?               @unique(map: "slug") @db.VarChar(255)
  content_markdown String?               @db.LongText
  content_html     String?               @db.LongText
  description      String?               @db.Text
  image            String?               @db.Text
  author_id        Int?
  article_type     articles_article_type
  reference_id     Int?
  is_published     Boolean?              @default(false)
  is_active        Boolean?              @default(true)
  created_at       DateTime?             @default(now()) @db.Timestamp(0)
  updated_at       DateTime?             @default(now()) @db.Timestamp(0)
  users            users?                @relation(fields: [author_id], references: [id], onUpdate: NoAction, map: "articles_ibfk_1")

  @@index([author_id], map: "author_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model clinics {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  address           String              @db.VarChar(255)
  phone             String?             @db.VarChar(20)
  email             String?             @db.VarChar(100)
  description       String?             @db.Text
  image             String?             @db.Text
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  updated_at        DateTime?           @default(now()) @db.Timestamp(0)
  doctor_workplaces doctor_workplaces[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model doctor_profiles {
  id                Int                 @id @default(autoincrement())
  user_id           Int                 @unique(map: "user_id")
  position          String?             @db.VarChar(100)
  degree            String?             @db.VarChar(100)
  experience_years  Int?                @default(0)
  consultation_fee  Decimal?            @default(0.00) @db.Decimal(10, 2)
  biography         String?             @db.Text
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  updated_at        DateTime?           @default(now()) @db.Timestamp(0)
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "doctor_profiles_ibfk_1")
  doctor_workplaces doctor_workplaces[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model doctor_workplaces {
  id               Int             @id @default(autoincrement())
  doctor_id        Int
  clinic_id        Int
  specialty_id     Int
  consultation_fee Decimal?        @default(0.00) @db.Decimal(10, 2)
  room             String?         @db.VarChar(50)
  position         String?         @db.VarChar(100)
  is_active        Boolean?        @default(true)
  created_at       DateTime?       @default(now()) @db.Timestamp(0)
  doctor_profiles  doctor_profiles @relation(fields: [doctor_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "doctor_workplaces_ibfk_1")
  clinics          clinics         @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "doctor_workplaces_ibfk_2")
  specialties      specialties     @relation(fields: [specialty_id], references: [id], onUpdate: NoAction, map: "doctor_workplaces_ibfk_3")
  schedules        schedules[]

  @@unique([doctor_id, clinic_id, specialty_id], map: "uk_doctor_workplace")
  @@index([clinic_id], map: "clinic_id")
  @@index([doctor_id, clinic_id], map: "idx_doctor_clinic")
  @@index([specialty_id], map: "specialty_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model invoices {
  id             Int                      @id @default(autoincrement())
  appointment_id Int
  invoice_type   invoices_invoice_type
  amount         Decimal                  @db.Decimal(10, 2)
  payment_method invoices_payment_method? @default(CASH)
  payment_status invoices_payment_status? @default(UNPAID)
  transaction_id String?                  @db.VarChar(100)
  payment_date   DateTime?                @db.DateTime(0)
  created_at     DateTime?                @default(now()) @db.Timestamp(0)
  updated_at     DateTime?                @default(now()) @db.Timestamp(0)
  appointments   appointments             @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoices_ibfk_1")

  @@index([appointment_id], map: "appointment_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model medical_records {
  id             Int            @id @default(autoincrement())
  appointment_id Int            @unique(map: "appointment_id")
