  blood_type        String?                 @db.VarChar(5)
  height            Decimal?                @db.Decimal(5, 2)
  weight            Decimal?                @db.Decimal(5, 2)
  insurance_number  String?                 @db.VarChar(100)
  emergency_contact String?                 @db.VarChar(100)
  created_at        DateTime?               @default(now()) @db.Timestamp(0)
  updated_at        DateTime?               @default(now()) @db.Timestamp(0)
  appointments      appointments[]
  users             users                   @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "patient_profiles_ibfk_1")
  reviews           reviews[]
  lab_orders        lab_orders[]

  @@index([account_id], map: "account_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model prescription_details {
  id              Int           @id @default(autoincrement())
  prescription_id Int
