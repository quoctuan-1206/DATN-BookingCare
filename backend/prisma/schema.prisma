  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @db.Text
  expires_at DateTime  @db.DateTime(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_ibfk_1")

  @@index([user_id], map: "user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model reviews {
  id                 Int              @id @default(autoincrement())
  doctor_id          Int
  patient_profile_id Int
  appointment_id     Int              @unique(map: "appointment_id")
  rating             Int?             @db.TinyInt
  comment            String?          @db.Text
  created_at         DateTime?        @default(now()) @db.Timestamp(0)
  users              users            @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_1")
  patient_profiles   patient_profiles @relation(fields: [patient_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_2")
  appointments       appointments     @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_ibfk_3")

  @@index([doctor_id], map: "doctor_id")
  @@index([patient_profile_id], map: "patient_profile_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model roles {
  id          Int       @id @default(autoincrement())
  name        String    @unique(map: "name") @db.VarChar(50)
  description String?   @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  users       users[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model schedules {
  id                  Int               @id @default(autoincrement())
  doctor_workplace_id Int
  work_date           DateTime          @db.Date
  start_time          DateTime          @db.Time(0)
  end_time            DateTime          @db.Time(0)
  max_patients        Int?              @default(10)
  booked_patients     Int?              @default(0)
  created_at          DateTime?         @default(now()) @db.Timestamp(0)
  updated_at          DateTime?         @default(now()) @db.Timestamp(0)
  appointments        appointments[]
  doctor_workplaces   doctor_workplaces @relation(fields: [doctor_workplace_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "schedules_ibfk_1")

  @@unique([doctor_workplace_id, work_date, start_time], map: "uk_schedule")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model specialties {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  description       String?             @db.Text
  image             String?             @db.Text
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamp(0)
  updated_at        DateTime?           @default(now()) @db.Timestamp(0)
  doctor_workplaces doctor_workplaces[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id               Int                @id @default(autoincrement())
  email            String             @unique(map: "email") @db.VarChar(100)
  password         String             @db.VarChar(255)
  first_name       String             @db.VarChar(100)
  last_name        String             @db.VarChar(100)
  phone            String?            @db.VarChar(20)
  gender           users_gender?
  date_of_birth    DateTime?          @db.Date
  address          String?            @db.VarChar(255)
  avatar           String?            @db.Text
  role_id          Int
  is_active        Boolean?           @default(true)
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  updated_at       DateTime?          @default(now()) @db.Timestamp(0)
  articles         articles[]
  doctor_profiles  doctor_profiles?
  notifications    notifications[]
  patient_profiles patient_profiles[]
  refresh_tokens   refresh_tokens[]
  reviews          reviews[]
  lab_orders                 lab_orders[]            @relation("LabOrderDoctor")
  accepted_lab_orders        lab_orders[]            @relation("LabOrderAcceptedBy")
  performed_lab_orders       lab_orders[]            @relation("LabOrderPerformedBy")
  lab_results                lab_results[]
  clinical_attachments       clinical_attachments[]
  clinical_order_events      clinical_order_events[]
  role             roles              @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "users_ibfk_1")

  @@index([email], map: "idx_user_email")
  @@index([phone], map: "idx_user_phone")
  @@index([role_id], map: "role_id")
}

model lab_tests {
  id                         Int                   @id @default(autoincrement())
  service_type               clinical_service_type @default(LAB)
  booking_mode               clinical_booking_mode @default(DOCTOR_ORDER)
  name                       String                @db.VarChar(255)
  image                      String?               @db.VarChar(500)
  description                String?               @db.Text
  preparation_instructions   String?               @db.Text
  estimated_duration_minutes Int?
  price                      Decimal               @default(0.00) @db.Decimal(10, 2)
  is_active                  Boolean               @default(true)
  created_at                 DateTime              @default(now()) @db.Timestamp(0)
  updated_at                 DateTime              @default(now()) @updatedAt @db.Timestamp(0)
  lab_results                lab_results[]

  @@index([is_active], map: "idx_lab_tests_active")
  @@index([service_type, is_active], map: "idx_lab_tests_type_active")
  @@index([booking_mode, is_active], map: "idx_lab_tests_booking_active")
}

model lab_schedules {
  id            Int                   @id @default(autoincrement())
  service_type  clinical_service_type @default(LAB)
  clinic_id     Int
  work_date     DateTime     @db.Date
  start_time    DateTime     @db.Time(0)
  end_time      DateTime     @db.Time(0)
  max_orders    Int          @default(10)
  booked_orders Int          @default(0)
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamp(0)
  updated_at    DateTime     @default(now()) @db.Timestamp(0)
  clinics       clinics      @relation(fields: [clinic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lab_schedules_clinic")
  lab_orders    lab_orders[]

  @@unique([clinic_id, service_type, work_date, start_time], map: "uk_lab_schedule")
  @@index([clinic_id], map: "idx_lab_schedules_clinic")
  @@index([service_type, work_date, is_active], map: "idx_lab_schedules_type_date_active")
  @@index([work_date], map: "idx_lab_schedules_date")
  @@index([is_active], map: "idx_lab_schedules_active")
}

model lab_orders {
  id                      Int                   @id @default(autoincrement())
  service_type            clinical_service_type @default(LAB)
  appointment_id          Int?
  lab_schedule_id         Int?
  patient_id              Int
  doctor_id               Int?
  accepted_by             Int?
  performed_by            Int?
  booking_code            String?               @unique(map: "uk_lab_orders_booking_code") @db.VarChar(50)
  indication              String?               @db.Text
  preparation_note        String?               @db.Text
  patient_note            String?               @db.Text
  result_file_name        String?               @db.VarChar(255)
  result_file_path        String?               @db.VarChar(255)
  result_file_type        String?               @db.VarChar(100)
  result_file_size        Int?
  result_uploaded_at      DateTime?             @db.DateTime(0)
  status                  lab_orders_status     @default(PENDING)
  ordered_at              DateTime              @default(now()) @db.Timestamp(0)
  started_at              DateTime?             @db.DateTime(0)
  performed_at            DateTime?             @db.DateTime(0)
  completed_at            DateTime?             @db.DateTime(0)
  cancelled_at            DateTime?             @db.DateTime(0)
  cancellation_reason     String?               @db.Text
  updated_at              DateTime              @default(now()) @updatedAt @db.Timestamp(0)
  appointments            appointments?         @relation(fields: [appointment_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_lab_orders_appointment")
  lab_schedules           lab_schedules?        @relation(fields: [lab_schedule_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_lab_orders_schedule")
  patient_profiles        patient_profiles      @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lab_orders_patient")
  users                   users?                @relation("LabOrderDoctor", fields: [doctor_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_lab_orders_doctor")
  accepted_by_user        users?                @relation("LabOrderAcceptedBy", fields: [accepted_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_lab_orders_accepted_by")
  performed_by_user       users?                @relation("LabOrderPerformedBy", fields: [performed_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_lab_orders_performed_by")
  lab_results             lab_results[]
  clinical_attachments    clinical_attachments[]
  clinical_order_events   clinical_order_events[]

  @@index([appointment_id], map: "idx_lab_orders_appointment")
  @@index([lab_schedule_id], map: "idx_lab_orders_schedule")
  @@index([patient_id], map: "idx_lab_orders_patient")
  @@index([doctor_id], map: "idx_lab_orders_doctor")
  @@index([accepted_by], map: "idx_lab_orders_accepted_by")
  @@index([performed_by], map: "idx_lab_orders_performed_by")
  @@index([status], map: "idx_lab_orders_status")
  @@index([service_type, status, ordered_at], map: "idx_lab_orders_type_status_ordered")
  @@index([patient_id, ordered_at], map: "idx_lab_orders_patient_ordered")
  @@index([doctor_id, ordered_at], map: "idx_lab_orders_doctor_ordered")
}

model lab_results {
  id                    Int        @id @default(autoincrement())
  lab_order_id          Int
  test_id               Int
  service_name_snapshot String?    @db.VarChar(255)
  price_snapshot        Decimal?   @db.Decimal(10, 2)
  result                String?    @db.Text
  unit                  String?    @db.VarChar(50)
  reference_range       String?    @db.VarChar(255)
  findings              String?    @db.Text
  conclusion            String?    @db.Text
  measurements          Json?
  note                  String?    @db.Text
  created_by            Int?
  created_at            DateTime?  @default(now()) @db.Timestamp(0)
  updated_at            DateTime   @default(now()) @updatedAt @db.Timestamp(0)
  lab_orders            lab_orders @relation(fields: [lab_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lab_results_order")
  lab_tests             lab_tests  @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lab_results_test")
  users                 users?     @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_lab_results_creator")

  @@unique([lab_order_id, test_id], map: "uk_lab_order_test")
  @@index([test_id], map: "idx_lab_results_test")
  @@index([created_by], map: "idx_lab_results_creator")
}

model clinical_attachments {
  id            Int                      @id @default(autoincrement())
  lab_order_id  Int
  kind          clinical_attachment_kind @default(DOCUMENT)
  original_name String                   @db.VarChar(255)
  storage_path  String                   @unique(map: "uk_clinical_attachments_storage_path") @db.VarChar(255)
  mime_type     String                   @db.VarChar(100)
  file_size     Int
  uploaded_by   Int?
  created_at    DateTime                 @default(now()) @db.Timestamp(0)
  lab_orders    lab_orders               @relation(fields: [lab_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clinical_attachments_order")
  users         users?                   @relation(fields: [uploaded_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_clinical_attachments_uploader")

  @@index([lab_order_id, kind], map: "idx_clinical_attachments_order_kind")
  @@index([uploaded_by], map: "idx_clinical_attachments_uploader")
}

model clinical_order_events {
  id           Int                       @id @default(autoincrement())
  lab_order_id Int
  event_type   clinical_order_event_type
  from_status  lab_orders_status?
  to_status    lab_orders_status?
  actor_id     Int?
  reason       String?                   @db.Text
  metadata     Json?
  created_at   DateTime                  @default(now()) @db.Timestamp(0)
  lab_orders   lab_orders                @relation(fields: [lab_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_clinical_order_events_order")
  users        users?                    @relation(fields: [actor_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_clinical_order_events_actor")

  @@index([lab_order_id, created_at], map: "idx_clinical_order_events_order_created")
  @@index([actor_id], map: "idx_clinical_order_events_actor")
}

enum invoices_invoice_type {
  CLINIC_FEE
  MEDICINE_FEE
}

enum appointments_status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum invoices_payment_method {
  CASH
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum patient_profiles_gender {
  Male
  Female
  Other
}

enum invoices_payment_status {
  UNPAID
  PAID
  REFUNDED
}

enum users_gender {
  Male
  Female
  Other
}

enum articles_article_type {
  DOCTOR
  CLINIC
  SPECIALTY
  NEWS
}

enum lab_orders_status {
