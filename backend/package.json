{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run db:prepare",
    "dev": "nodemon src/server.js",
    "prestart": "npm run db:prepare",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test",
    "check:clinical-permissions": "node scripts/check-clinical-permissions.js",
    "db:migrate": "node scripts/ensure-clinic-content-columns.js && node scripts/ensure-lab-schema.js && node scripts/ensure-payment-schema.js",
    "db:generate": "prisma generate",
    "db:prepare": "npm run db:migrate && npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "prisma": "^6.19.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
